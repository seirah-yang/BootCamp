# 회귀모델의 성능평가지표 
# MAE(Mean Absolute Error) : 실제값(y)와 예측값(y^)차이의 절대값을 평균한 값
# MAE값이 작을 수록 모델이 잘 학습됐다고 할 수 있다. 

# -- 에러의 크기가 그래도 반영됨 
# -- 이상치에 민감하지 않음 
# -- 절대값을 사용함으로 직관적으로 알 수 있는 지표 

	# MAE 구하기 : 쉽게 말해 예측값이 평균적으로 어느 정도 틀렸는지를 확인하는 지표 
from sklearn.metrics import mean_absolute_error

y = [2,3,4,1,5]
y_pred = [1.5, 2.5, 5, 2, 4.5]

mae = mean_absolute_error(y, y_pred)

print("mae : ", mae) #mae : 0.7